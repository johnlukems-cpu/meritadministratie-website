# Kopieer dit bestand naar .env en vul de waarden in. Commit .env NOOIT (staat in .gitignore).
#
# Twee soorten variabelen:
#   VITE_*   → worden in de browserbundel opgenomen en zijn dus PUBLIEK. Nooit geheimen.
#   overige  → alleen server-side (Vercel-functies in api/). Hier horen API-keys.
#
# Op Vercel: Settings → Environment Variables. Zet server-side keys voor de omgevingen
# Preview én Production (Preview eerst, om veilig te testen).

# --- Formulieren (frontend) --------------------------------------------------------
# Provider voor contact-, offerte- en kennismakingsformulier (zie src/lib/forms/provider.ts).
#   api      → eigen Vercel-functie /api/contact → Resend (standaard)
#   mailto   → opent het e-mailprogramma van de bezoeker (fallback, bijv. lokaal met `vite`)
#   webhook  → POST JSON naar VITE_FORM_ENDPOINT (Formspree, Make, Zapier, n8n, …)
VITE_FORM_PROVIDER=api
VITE_FORM_ENDPOINT=

# --- E-mail via Resend (server-side, alleen in api/contact.ts) -----------------------
# API-key uit https://resend.com/api-keys (permissie "Sending access" volstaat).
RESEND_API_KEY=
# Afzender. Vereist een in Resend geverifieerd (sub)domein.
# Voor een eerste test zonder domeinverificatie: onboarding@resend.dev (mailt alleen naar het
# e-mailadres van het Resend-account zelf).
RESEND_FROM="MERIT Administratie & Advies <noreply@meritadministratie.nl>"
# Ontvanger van de interne melding (standaard info@meritadministratie.nl).
CONTACT_TO=info@meritadministratie.nl

# --- MERIT Content Studio (/admin/content) — server-side ------------------------------
# Toegang tot het beveiligde admin-gedeelte. Zonder deze twee variabelen is de
# Content Studio volledig gesloten (fail closed) en toont hij een instelmelding.
# Wachtwoord voor de Content Studio.
ADMIN_PASSWORD=
# Willekeurige string van minimaal 32 tekens om de sessiecookie te ondertekenen.
# Genereren: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Geldigheid van een sessie in uren (optioneel, standaard 8).
ADMIN_SESSION_HOURS=8

# --- Opslag van de content: Redis (server-side) ---------------------------------------
# De Content Studio bewaart content in Redis via de REST-API. Koppel in Vercel
# Storage → Marketplace → Upstash (Serverless Redis) aan dit project; Vercel zet deze
# twee variabelen dan automatisch, voor de omgevingen die u aanvinkt.
# Zonder deze variabelen valt de studio terug op tijdelijk geheugen en toont het
# dashboard een waarschuwing dat content kan verdwijnen.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternatief wanneer u Upstash rechtstreeks gebruikt (in plaats van bovenstaande):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Let op: een TCP-verbindingsreeks (REDIS_URL) wordt NIET gebruikt; deze opslaglaag
# werkt uitsluitend via de REST-API, omdat serverless functies geen langlevende
# TCP-verbinding kunnen aanhouden.

# --- Tracking (wordt pas geladen na cookie-toestemming; leeg = uit) -------------------
# Google Analytics 4 measurement-ID, bijv. G-XXXXXXXXXX
VITE_ANALYTICS_ID=
# Meta (Facebook) Pixel-ID
VITE_META_PIXEL_ID=
